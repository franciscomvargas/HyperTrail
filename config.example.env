# HyperTrail Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# NETWORK SELECTION
# =============================================================================
# Choose between TESTNET (recommended for development) or MAINNET
HYPERLIQUID_NETWORK=TESTNET

# =============================================================================
# API CREDENTIALS - Get these from https://hyperliquid.xyz/understanding_api
# =============================================================================

# Mainnet Credentials (for production trading)
HYPERLIQUID_MAINNET_PUBLIC_KEY=your_mainnet_public_key_here
HYPERLIQUID_MAINNET_SECRET_KEY=your_mainnet_secret_key_here

# Testnet Credentials (for testing and development)
HYPERLIQUID_TESTNET_PUBLIC_KEY=your_testnet_public_key_here
HYPERLIQUID_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Custom logs directory (default: ./logs)
# LOGS_DIR=./custom_logs_dir

