# HyperTrail Environment Configuration Example
# Copy this file to .env and fill in your API credentials before running

# ============================================================================
# HYPERLIQUID NETWORK SELECTION
# Use "testnet" for development and testing without real money
# Switch to "mainnet" only when you're ready to trade with real funds!
# ============================================================================
HYPERLIQUID_NETWORK="testnet"

# ============================================================================
# API WALLET CREDENTIALS
# Get these from: https://app.hyperliquid.xyz/API
# 
# SECURITY WARNING: Never share your secret key or commit files containing it!
# The .env file is already in .gitignore to prevent accidental commits
# ============================================================================

# Your main wallet's public address (full required for API)
HYPERLIQUID_ACCOUNT_ADDRESS=""

# Your API private key (generate new one from Hyperliquid dashboard)
HYPERLIQUID_MAINNET_SECRET_KEY=""
HYPERLIQUID_TESTNET_SECRET_KEY=""

# ============================================================================
# NOTES:
# - HYPERLIQUID_ACCOUNT_ADDRESS: The public address of your main wallet
#   (not to be confused with the API wallet's public key)
# - HYPERLIQUID_SECRET_KEY: Your API secret key, can be generated/regenerated
#   in the Hyperliquid web interface under "API" tab
# 
# TIP: For testnet trading, you can get test tokens from the Hyperliquid Discord
# ============================================================================
